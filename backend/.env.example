# Copy this file to .env and fill in real values. Never commit .env.

# --- CognoDB (graph database, Bolt 5.x) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme

# Connection pool (optional - sane defaults apply if omitted)
NEO4J_POOL_MAX_SIZE=50
NEO4J_POOL_ACQUISITION_TIMEOUT_SECONDS=30
NEO4J_POOL_MAX_LIFETIME_MINUTES=60
NEO4J_CONNECTION_TIMEOUT_SECONDS=10

# --- Application ---
SERVER_PORT=8080
DEVGRAPH_SEED_ENABLED=false
# DANGER: wipes every node/relationship before reseeding. Dev/scratch DBs only.
DEVGRAPH_SEED_RESET=false
LOG_LEVEL=INFO
# ALWAYS for colorized console logs (local/dev); NEVER for log aggregators
# that don't want raw ANSI escape codes in captured output.
SPRING_OUTPUT_ANSI_ENABLED=ALWAYS

# Comma-separated list of allowed frontend origins. Never use "*" in
# production - list the exact origin(s) the frontend is served from.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
